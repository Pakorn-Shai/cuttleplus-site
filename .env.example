DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_hub"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_THEME_ID="default"
OWNER_EMAIL="owner@example.com"
# ADMIN_USERNAME may be used instead of OWNER_EMAIL during migration from CuttlePlus.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# S3-compatible object storage (AWS S3, Cloudflare R2, etc.).
# Leave empty during local development to use public/uploads.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""
STORAGE_FORCE_PATH_STYLE="false"
MAX_UPLOAD_BYTES="5242880"

# OpenRouter AI provider.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPTIMIZER_MODEL="openai/gpt-5.6-luna-pro"
# Legacy fallback used only when OPTIMIZER_MODEL is empty.
OPENROUTER_MODEL=""
AI_MAX_TOKENS="4096"
AI_TIMEOUT="60000"
