DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowledge_hub"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_THEME_ID="default"
OWNER_EMAIL="owner@example.com"
# ADMIN_USERNAME may be used instead of OWNER_EMAIL during migration from CuttlePlus.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# S3-compatible object storage (AWS S3, Cloudflare R2, etc.).
# Leave empty during local development to use public/uploads.
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""
STORAGE_FORCE_PATH_STYLE="false"
MAX_UPLOAD_BYTES="5242880"

# AI provider selection for SEO analysis (metadata + taxonomy suggestions).
# The primary provider is tried first; on failure the request automatically
# falls back to AI_FALLBACK_PROVIDER.
AI_PROVIDER="typhoon"
AI_FALLBACK_PROVIDER="openrouter"

# Typhoon AI provider (OpenTyphoon) — primary for SEO analysis.
TYPHOON_API_KEY=""
TYPHOON_BASE_URL="https://api.opentyphoon.ai/v1"
TYPHOON_MODEL="typhoon-v2.5-30b-a3b-instruct"
TYPHOON_MAX_TOKENS="8000"
TYPHOON_TIMEOUT="30000"

# OpenRouter AI provider — fallback for SEO analysis, also used for
# readability suggestions, the assistant, and learning paths.
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPTIMIZER_MODEL="openai/gpt-5.6-luna-pro"
# Legacy fallback used only when OPTIMIZER_MODEL is empty.
OPENROUTER_MODEL=""
AI_MAX_TOKENS="4096"
AI_TIMEOUT="60000"
